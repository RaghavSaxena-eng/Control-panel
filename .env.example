# ─── Server ───────────────────────────────────
PORT=3000

# ─── MongoDB ──────────────────────────────────
MONGO_URI=mongodb://localhost:27017/controlpanel

# ─── Redis (BullMQ) ───────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── AWS ──────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE

# The EC2 instance must have the SSM Agent installed
# and an IAM role with AmazonSSMManagedInstanceCore
EC2_INSTANCE_ID=i-0123456789abcdef0

# The Lambda function to invoke after Docker setup
LAMBDA_FUNCTION_NAME=post-deploy-setup
